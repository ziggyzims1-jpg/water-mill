{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-setup.sh\"; bd prime --hook-json",
            "type": "command",
            "timeout": 600
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-git.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(/Users/andrewzimmerman/Documents/code/water-mill/bin/watermill remember:*)",
      "Bash(bin/watermill remember:*)"
    ]
  }
}
